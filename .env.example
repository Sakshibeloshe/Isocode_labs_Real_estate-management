# Postgres (Neon free tier works). Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# only for `npm test`: a throwaway database, tables are truncated
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB_test"
# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=""
# any OpenAI-compatible endpoint; default Groq
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="qwen/qwen3.8-27b"
LLM_API_KEY=""
# public URL used in SMS links
APP_URL="http://localhost:3000"
# protects /api/cron/reminders
CRON_SECRET=""
